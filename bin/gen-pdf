#! /usr/bin/env ruby
#
# Generate a PDF from markdown input (paper.md) in dir
#
# Usage:   gen-pdf [--debug] dir [output.pdf]
#
# Example: ./bin/gen-pdf ./example/logic
#          ./bin/gen-pdf ./example/logic output.pdf
#          ./bin/gen-pdf --debug ./example/logic output.tex
#
# Note that combining --debug with PDF output may lead to an error. See
# https://github.com/jgm/pandoc/issues/5997

class GenPdfError < StandardError
end

rootpath = File.dirname(File.dirname(__FILE__))
$: << File.join(rootpath,'lib')

require 'fileutils'
require 'time'
require 'bhxiv/markdown' # QC methods for YAML header

# p ARGV  # Debug line - uncomment if needed

dir = ARGV.shift
if dir == "--debug"
  dir = ARGV.shift
  is_debug = true
end
unless dir
  $stderr.puts "Error: Directory argument is required"
  $stderr.puts "Usage: gen-pdf [--debug] dir [output.pdf]"
  exit(1)
end

unless File.directory?(dir)
  $stderr.puts "Error: Directory '#{dir}' does not exist or is not a directory"
  exit(1)
end

print "Scanning directory \"#{dir}\" for paper source\n"

outfn = ARGV.shift
outfn = "paper.pdf" unless outfn

$stderr.print("Generating #{outfn}\n")
Dir.chdir(dir) do
  File.unlink(outfn) if File.exist?(outfn)
end

papermd = File.join(dir, "paper.md")
raise GenPdfError, "Cannot find markdown file #{papermd}" unless File.exist?(papermd)

header = md_parser(papermd)
meta = meta_expand(header)
md_meta_checker(meta)

paperbib = File.join(dir, "paper.bib")
unless File.exist?(paperbib)
  $stderr.puts "WARNING: Cannot find bibtex file #{paperbib}, creating empty file"
  `touch #{paperbib}`
end

rootdir = File.expand_path(File.dirname(File.dirname(__FILE__)))
resources = File.join(rootdir, "resources", "biohackrxiv")

# Event metadata is now always taken from the markdown file metadata
EVENT = {
  title: meta['biohackathon_name'],
  URL:   meta['biohackathon_url'],
  location: meta['biohackathon_location']
}

# Get git_url from metadata

git_url = meta['git_url']
raise GenPdfError, "git_url is undefined in metadata - provide 'git_url' in the markdown header as a reference to the git repo" unless git_url

JOURNAL = 'biohackrxiv'
JOURNAL_NAME = 'BioHackrXiv.org'
JOURNAL_URL = 'https://biohackrxiv.org/'
TEX = File.join(resources, "latex.template")
EXTRACT_CITO = File.join(resources, "filters", "extract-cito.lua")
CITO_TO_BIBLATEX = File.join(resources, "filters", "cito-to-biblatex.lua")
STRIP_TRAILING_REFERENCES = File.join(resources, "filters", "strip-trailing-references-heading.lua")
SVG_TO_PDF = File.join(resources, "filters", "svg-to-pdf.lua")
JOURNAL_LOGO = File.join(resources, "logo.png")

time = Time.new
date = time.strftime("%d %b %Y")

# With --biblatex, pandoc emits plain \cite{key} and leaves the actual
# bibliography rendering (\printbibliography, driven by latex.template) to
# biblatex/biber at LaTeX-compile time - this is what lets the template
# place "Author contributions" before References. Unlike the --citeproc
# pipeline this replaces, pandoc's own PDF pipeline cannot drive this: it
# reruns the LaTeX engine but never invokes biber, so pandoc is only asked
# to produce the intermediate .tex file here, and biber/lualatex are run
# by hand below (the same sequence as tmp-info/template's Makefiles).
want_tex_only = File.extname(outfn) == ".tex"
texfn = want_tex_only ? outfn : "#{File.basename(outfn, File.extname(outfn))}.tex"
pdffn = "#{File.basename(texfn, '.tex')}.pdf"

cmd = <<~COMMAND
      #{is_debug ? "--verbose" : ""}
      -V journal_name='#{JOURNAL_NAME}'
      -V journal_url='#{JOURNAL_URL}'
      -V logo_path='#{JOURNAL_LOGO}'
      -V year='#{time.year}'
      -V submitted='#{date}'
      -V git_url='#{git_url}'
      -V event_title='#{EVENT[:title]}'
      -V event_url='#{EVENT[:URL]}'
      -V event_location='#{EVENT[:location]}'
      -V geometry:margin=1in
      --from markdown+autolink_bare_uris
      --template '#{TEX}'
      --pdf-engine=lualatex
      --biblatex
      --lua-filter='#{STRIP_TRAILING_REFERENCES}'
      --lua-filter='#{SVG_TO_PDF}'
      --lua-filter='#{EXTRACT_CITO}'
      --lua-filter='#{CITO_TO_BIBLATEX}'
      -s
      --output='#{texfn}'
      paper.md
COMMAND

# Build pandoc command
cmd2 = 'pandoc ' + cmd.split(/\s*\n\s*/).join(" ")

def run_step(description, cmd, is_debug)
  puts "Executing: #{cmd}" if is_debug
  output = `#{cmd} 2>&1`
  print output if is_debug
  unless $?.success?
    $stderr.puts output unless is_debug
    $stderr.puts "Failed: #{description}"
    exit(2)
  end
end

print "Changing to directory #{dir}\n"
Dir.chdir(dir) do
  run_step("pandoc", cmd2, is_debug)
  unless File.exist?(texfn)
    $stderr.puts "Failed to generate #{texfn}!"
    exit(2)
  end

  if want_tex_only
    puts "Generated #{outfn}!"
  else
    jobname = File.basename(texfn, ".tex")
    latexcmd = "lualatex -interaction=nonstopmode -halt-on-error '#{texfn}'"
    run_step("lualatex (pass 1)", latexcmd, is_debug)
    run_step("biber", "biber '#{jobname}'", is_debug)
    run_step("lualatex (pass 2)", latexcmd, is_debug)
    run_step("lualatex (pass 3)", latexcmd, is_debug)

    if File.exist?(pdffn)
      FileUtils.mv(pdffn, outfn) unless File.expand_path(pdffn) == File.expand_path(outfn)
      FileUtils.rm_f(texfn)
      %w[.aux .bbl .bcf .blg .log .out .run.xml .toc].each do |ext|
        FileUtils.rm_f(jobname + ext)
      end
      puts "Generated #{outfn}!"
    else
      $stderr.puts "Failed to generate #{outfn}!"
      exit(2)
    end
  end
end
